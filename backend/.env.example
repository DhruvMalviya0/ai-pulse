# Copy to backend/.env for local development:  cp .env.example .env
# APP_ENV: dev | test | production. Production refuses to start with a weak or missing SECRET_KEY,
# and refuses to run the seed script.
APP_ENV=dev

# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Leave empty in dev to get a random key per process (you'll be logged out on every reload).
SECRET_KEY=

DATABASE_URL=sqlite:///./aipulse.db

# Comma-separated list of origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:5173

# mock = canned responses from data/mock_ai_responses.json, live = OpenAI-compatible endpoint
# Production refuses to start unless this is live (mock replies ignore what people wrote).
AI_MODE=mock
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
